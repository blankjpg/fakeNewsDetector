{
  "manifest_version": 3,
  "name": "Fake News Detector",
  "version": "1.0",
  "description": "AI-powered fake news detector.",
  "permissions": [
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}